# Copy to .env.local for local development. DO NOT commit real values.

# Firebase Admin credentials (from the service account JSON)
FIREBASE_PROJECT_ID=jf-job-tracker
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jf-job-tracker.iam.gserviceaccount.com
# Paste the full private_key value here, including the BEGIN/END lines.
# Wrap in double quotes; literal \n inside the string will be converted to newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloud Storage bucket. Defaults to <project-id>.appspot.com if omitted.
FIREBASE_STORAGE_BUCKET=jf-job-tracker.appspot.com

# Anthropic API key for the in-app job assistant chat. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model used by the assistant.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
